# ─────────────────────────────────────────
# GlowUp AI — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your API keys

# REQUIRED: Anthropic API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# REQUIRED for photo generation: FAL.ai API Key
# Get yours at: https://fal.ai/dashboard
FAL_KEY=...your-fal-key...

# OPTIONAL: Secret key for session tokens (auto-generated if not set)
SECRET_KEY=your-random-secret-here

# OPTIONAL: Server port (default: 8000)
PORT=8000
